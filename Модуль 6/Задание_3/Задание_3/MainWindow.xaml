<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека"
        Height="650" Width="1000"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Учёт книг в библиотеке"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#51347A"
                   Margin="0,0,0,18"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch"
                         Height="35"
                         VerticalContentAlignment="Center"
                         ToolTip="Введите название книги или автора"/>

                <Button Grid.Column="1"
                        Content="Найти"
                        Click="Search_Click"
                        Width="90"
                        Height="35"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="2"
                        Content="Показать все"
                        Click="ShowAll_Click"
                        Height="35"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Информация о книге"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Название книги"/>
                    <TextBox x:Name="txtTitle"
                             Height="32"
                             Margin="0,5,0,12"/>

                    <TextBlock Text="Автор"/>
                    <TextBox x:Name="txtAuthor"
                             Height="32"
                             Margin="0,5,0,12"/>

                    <TextBlock Text="Год издания"/>
                    <TextBox x:Name="txtYear"
                             Height="32"
                             Margin="0,5,0,18"/>

                    <Button Content="Добавить книгу"
                            Click="Add_Click"
                            Height="38"
                            Margin="0,0,0,8"
                            Background="#7047A3"
                            Foreground="White"/>

                    <Button Content="Удалить книгу"
                            Click="Delete_Click"
                            Height="38"
                            Margin="0,0,0,8"/>

                    <Button Content="Выдать книгу"
                            Click="Borrow_Click"
                            Height="38"
                            Margin="0,0,0,8"/>

                    <Button Content="Вернуть книгу"
                            Click="Return_Click"
                            Height="38"
                            Margin="0,0,0,8"/>

                    <Button Content="Очистить поля"
                            Click="Clear_Click"
                            Height="38"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="BooksGrid"
                      Grid.Column="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="BooksGrid_SelectionChanged"
                      CanUserAddRows="False"
                      Background="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"/>
        </Grid>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Text="Готово к работе"
                   Foreground="#51347A"
                   Margin="0,15,0,0"
                   FontSize="14"/>
    </Grid>
</Window>