<Window x:Class="Задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рисование на холсте"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F2EDFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="15">

            <TextBlock Text="Инструмент:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontSize="14"/>

            <ComboBox x:Name="comboBox1"
                      Width="150"
                      Height="30"
                      SelectedIndex="0"
                      Margin="0,0,15,0">
                <ComboBoxItem Content="Свободно"/>
                <ComboBoxItem Content="Линия"/>
                <ComboBoxItem Content="Круг"/>
                <ComboBoxItem Content="Квадрат"/>
            </ComboBox>

            <Button x:Name="button1"
                    Content="Очистить"
                    Width="100"
                    Height="30"
                    Click="button1_Click"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="15,0,15,15"
                BorderBrush="#B7A2E8"
                BorderThickness="2"
                Background="White">

            <Canvas x:Name="DrawingCanvas"
                    Background="White"
                    ClipToBounds="True"
                    MouseLeftButtonDown="DrawingCanvas_MouseDown"
                    MouseMove="DrawingCanvas_MouseMove"
                    MouseLeftButtonUp="DrawingCanvas_MouseUp"/>
        </Border>
    </Grid>
</Window>