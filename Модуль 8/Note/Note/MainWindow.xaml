<Window x:Class="Note.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteFlow" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1ECFA">

    <DockPanel Margin="15">
        <Border DockPanel.Dock="Top" Background="#7956C8"
                Padding="15" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Note" FontSize="25"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Текстовый редактор"
                           Foreground="#EEE6FF"/>
            </StackPanel>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,10">
            <Button Content="Новый" Width="75" Margin="3"
                    Background="White" Click="New_Click"/>
            <Button Content="Открыть" Width="75" Margin="3"
                    Background="White" Click="Open_Click"/>
            <Button Content="Сохранить" Width="85" Margin="3"
                    Background="White" Click="Save_Click"/>

            <Button Content="B" FontWeight="Bold" Width="35"
                    Margin="3" Background="White" Click="Bold_Click"/>
            <Button Content="I" FontStyle="Italic" Width="35"
                    Margin="3" Background="White" Click="Italic_Click"/>
            <Button Content="U" Width="35" Margin="3"
                    Background="White" Click="Underline_Click"/>

            <ComboBox x:Name="FontFamilyBox" Width="140" Margin="5"
                      SelectedIndex="0"
                      SelectionChanged="FontFamily_Changed">
                <ComboBoxItem Content="Segoe UI"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
                <ComboBoxItem Content="Georgia"/>
                <ComboBoxItem Content="Calibri"/>
                <ComboBoxItem Content="Consolas"/>
                <ComboBoxItem Content="Verdana"/>
            </ComboBox>

            <ComboBox x:Name="FontSizeBox" Width="60" Margin="5"
                      SelectedIndex="1"
                      SelectionChanged="FontSize_Changed">
                <ComboBoxItem Content="12"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="36"/>
            </ComboBox>
        </WrapPanel>

        <Border Background="White" CornerRadius="8" Padding="10">
            <RichTextBox x:Name="Editor" BorderThickness="0"
                         FontFamily="Segoe UI" FontSize="14"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto">
                <FlowDocument/>
            </RichTextBox>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Text="Готово" Foreground="#75658D"
                   Margin="3,8,0,0"/>
    </DockPanel>
</Window>