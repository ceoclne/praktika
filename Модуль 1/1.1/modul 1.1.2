using System;

class Program
{
    static void Main()
    {
        Console.Write("Введите целое число: ");
        int number = int.Parse(Console.ReadLine());

        // Если остаток от деления на 2 равен 0, число чётное
        if (number % 2 == 0)
        {
            Console.WriteLine("Число является чётным.");
        }
        else
        {
            Console.WriteLine("Число является нечётным.");
        }
    }
}