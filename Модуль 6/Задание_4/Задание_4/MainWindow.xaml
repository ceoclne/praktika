<Window x:Class="Задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт финансов"
        Height="700" Width="1050"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Учёт доходов и расходов"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#51347A"
                   Margin="0,0,0,18"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="10"
                    Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Общий доход"
                               Foreground="#39845A"/>
                    <TextBlock x:Name="txtIncome"
                               Text="0,00"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#39845A"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10"
                    Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Общий расход"
                               Foreground="#B84A57"/>
                    <TextBlock x:Name="txtExpense"
                               Text="0,00"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#B84A57"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Остаток"/>
                    <TextBlock x:Name="txtBalance"
                               Text="0,00"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#51347A"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="12"
                    Padding="15" Margin="0,0,15,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Данные операции"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Тип операции"/>
                        <ComboBox x:Name="cmbType"
                                  Height="32" Margin="0,5,0,12"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Доход"/>
                            <ComboBoxItem Content="Расход"/>
                        </ComboBox>

                        <TextBlock Text="Категория"/>
                        <TextBox x:Name="txtCategory"
                                 Height="32" Margin="0,5,0,12"/>

                        <TextBlock Text="Сумма"/>
                        <TextBox x:Name="txtAmount"
                                 Height="32" Margin="0,5,0,12"/>

                        <TextBlock Text="Дата"/>
                        <DatePicker x:Name="dpDate"
                                    Height="32" Margin="0,5,0,12"/>

                        <TextBlock Text="Описание"/>
                        <TextBox x:Name="txtDescription"
                                 Height="65" Margin="0,5,0,15"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button Content="Добавить запись"
                                Click="Add_Click"
                                Height="36" Margin="0,0,0,7"
                                Background="#7047A3"
                                Foreground="White"/>

                        <Button Content="Редактировать запись"
                                Click="Edit_Click"
                                Height="36" Margin="0,0,0,7"/>

                        <Button Content="Удалить запись"
                                Click="Delete_Click"
                                Height="36" Margin="0,0,0,7"/>

                        <Button Content="Очистить поля"
                                Click="Clear_Click"
                                Height="36"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DataGrid x:Name="FinanceGrid"
                      Grid.Column="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="FinanceGrid_SelectionChanged"
                      CanUserAddRows="False"
                      Background="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"/>
        </Grid>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Text="Готово к работе"
                   Foreground="#51347A"
                   Margin="0,15,0,0"
                   FontSize="14"/>
    </Grid>
</Window>