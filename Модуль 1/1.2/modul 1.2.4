using System;
class Program
{
    static void Main()
    {
        Console.Write("Введите K: ");
        int k = int.Parse(Console.ReadLine());
        Console.Write("Введите A: ");
        int a = int.Parse(Console.ReadLine());
        Console.Write("Введите B: ");
        int b = int.Parse(Console.ReadLine());
        int[] array = new int[k];
        Random random = new Random();
        // Заполняем массив случайными числами из диапазона [A, B)
        for (int i = 0; i < k; i++)
        {
            array[i] = random.Next(a, b);
        }
        Console.WriteLine("\nМассив:");
        for (int i = 0; i < k; i++)
        {
            Console.Write(array[i] + " ");
        }
        int minIndex = 0;
        int maxIndex = 0;
        for (int i = 1; i < k; i++)
        {
            if (array[i] < array[minIndex])
                minIndex = i;

            if (array[i] > array[maxIndex])
                maxIndex = i;
        }

        Console.WriteLine();
        Console.WriteLine($"Минимальный элемент: {array[minIndex]}, индекс: {minIndex}");
        Console.WriteLine($"Максимальный элемент: {array[maxIndex]}, индекс: {maxIndex}");
        int start = Math.Min(minIndex, maxIndex);
        int end = Math.Max(minIndex, maxIndex);
        Console.WriteLine("Элементы между найденными индексами:");
        for (int i = start; i <= end; i++)
        {
            Console.Write(array[i] + " ");
        }
        Console.WriteLine();
    }
}