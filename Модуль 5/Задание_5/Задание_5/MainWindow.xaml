<Window x:Class="Задание_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="570" Width="370"
        MinHeight="520" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="#F2EDFF"
        ResizeMode="CanResize">

    <Border Margin="18"
            Padding="18"
            Background="White"
            CornerRadius="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Калькулятор"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#493477"
                       Margin="0,0,0,16"/>

            <TextBox x:Name="txtDisplay"
                     Grid.Row="1"
                     Text="0"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontSize="32"
                     FontWeight="SemiBold"
                     Foreground="#493477"
                     Background="#F7F3FF"
                     BorderBrush="#DED3F7"
                     BorderThickness="1"
                     Padding="12"
                     Margin="0,0,0,18"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"/>

            <UniformGrid Grid.Row="2"
             Rows="5"
             Columns="4">

                <Button Content="C" Click="Button_Click"
            Background="#E3D7FA" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="÷" Click="Button_Click"
            Background="#E3D7FA" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="×" Click="Button_Click"
            Background="#E3D7FA" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="−" Click="Button_Click"
            Background="#7655C9" Foreground="White"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="1" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="2" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="3" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="+" Click="Button_Click"
            Background="#7655C9" Foreground="White"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="4" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="5" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="6" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="=" Click="Button_Click"
            Background="#7655C9" Foreground="White"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="7" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="8" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="9" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="0" Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

                <Button Content="," Click="Button_Click"
            Background="#F7F3FF" Foreground="#493477"
            FontSize="20" Margin="4" BorderThickness="0"/>

            </UniformGrid>

        </Grid>
    </Border>
</Window>