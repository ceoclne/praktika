<Window x:Class="Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер проектов" Height="750" Width="1150"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Background="#F2EDFF" Margin="12">

            <TextBlock Text="МЕНЕДЖЕР ПРОЕКТОВ"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#493477" Margin="5,5,5,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Проекты" Grid.Column="0" Margin="4">
                    <StackPanel Margin="8">
                        <TextBlock Text="Название проекта"/>
                        <TextBox x:Name="ProjectName" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Описание"/>
                        <TextBox x:Name="ProjectDescription" Padding="6"
                                 Height="55" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,3,0,8"/>

                        <WrapPanel>
                            <Button Content="Добавить" Click="AddProject" Margin="2" Padding="7"/>
                            <Button Content="Изменить" Click="EditProject" Margin="2" Padding="7"/>
                            <Button Content="Удалить" Click="DeleteProject" Margin="2" Padding="7"/>
                        </WrapPanel>

                        <TextBlock Text="Дважды проверь ID в таблице ниже."
                                   TextWrapping="Wrap" Margin="2,5"/>

                        <DataGrid x:Name="ProjectsGrid" Height="230"
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  SelectionChanged="ProjectsGrid_SelectionChanged"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Сотрудники" Grid.Column="1" Margin="4">
                    <StackPanel Margin="8">
                        <TextBlock Text="ФИО сотрудника"/>
                        <TextBox x:Name="EmployeeName" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Должность"/>
                        <TextBox x:Name="EmployeePosition" Padding="6"
                                 Margin="0,3,0,8"/>

                        <WrapPanel>
                            <Button Content="Добавить" Click="AddEmployee" Margin="2" Padding="7"/>
                            <Button Content="Изменить" Click="EditEmployee" Margin="2" Padding="7"/>
                            <Button Content="Удалить" Click="DeleteEmployee" Margin="2" Padding="7"/>
                        </WrapPanel>

                        <TextBlock Text="Выбери сотрудника, чтобы изменить его."
                                   TextWrapping="Wrap" Margin="2,5"/>

                        <DataGrid x:Name="EmployeesGrid" Height="230"
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  SelectionChanged="EmployeesGrid_SelectionChanged"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Задачи" Grid.Column="2" Margin="4">
                    <StackPanel Margin="8">
                        <TextBlock Text="Название задачи"/>
                        <TextBox x:Name="TaskName" Padding="6" Margin="0,3,0,6"/>

                        <TextBlock Text="ID проекта (из таблицы проектов)"/>
                        <TextBox x:Name="TaskProjectId" Padding="6" Margin="0,3,0,6"/>

                        <TextBlock Text="ID сотрудника (из таблицы сотрудников)"/>
                        <TextBox x:Name="TaskEmployeeId" Padding="6" Margin="0,3,0,6"/>

                        <TextBlock Text="Статус"/>
                        <ComboBox x:Name="TaskStatus" SelectedIndex="0"
                                  Padding="5" Margin="0,3,0,6">
                            <ComboBoxItem Content="Новая"/>
                            <ComboBoxItem Content="В работе"/>
                            <ComboBoxItem Content="Завершена"/>
                        </ComboBox>

                        <TextBlock Text="Прогресс (0–100%)"/>
                        <TextBox x:Name="TaskProgress" Text="0"
                                 Padding="6" Margin="0,3,0,8"/>

                        <WrapPanel>
                            <Button Content="Добавить" Click="AddTask" Margin="2" Padding="7"/>
                            <Button Content="Изменить" Click="EditTask" Margin="2" Padding="7"/>
                            <Button Content="Удалить" Click="DeleteTask" Margin="2" Padding="7"/>
                        </WrapPanel>

                        <DataGrid x:Name="TasksGrid" Height="190"
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  SelectionChanged="TasksGrid_SelectionChanged"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Header="Отчёт по проектам" Margin="4,12,4,4">
                <StackPanel Margin="8">
                    <Button Content="Сформировать и сохранить отчёт"
                            Click="CreateReport" Padding="8"
                            HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBox x:Name="ReportText" Height="150"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>