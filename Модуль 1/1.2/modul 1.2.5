using System;
using System.Collections.Generic;
class Program
{
    static void Main()
    {
        Console.Write("Введите K: ");
        int k = int.Parse(Console.ReadLine());
        char[] array = new char[k];
        Random random = new Random();
        string alphabet = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
        // Заполняем массив случайными буквами
        for (int i = 0; i < k; i++)
        {
            array[i] = alphabet[random.Next(alphabet.Length)];
        }
        // Список для хранения согласных букв
        List<char> consonants = new List<char>();
        string vowels = "аеёиоуыэюя";
        for (int i = 0; i < k; i++)
        {
            if (!vowels.Contains(array[i]) &&
                array[i] != 'ъ' &&
                array[i] != 'ь')
            {
                consonants.Add(array[i]);
            }
        }
        Console.WriteLine("Первый массив:");
        for (int i = 0; i < k; i++)
        {
            Console.Write(array[i] + " ");
        }
        Console.WriteLine();
        Console.WriteLine("Массив согласных:");
        for (int i = 0; i < consonants.Count; i++)
        {
            Console.Write(consonants[i] + " ");
        }
    }
}