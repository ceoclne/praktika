<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач"
        Height="750" Width="1000"
        MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F2EDFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои задачи"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#493477"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="Информация о задаче"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#493477"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Название"
                               Margin="0,0,10,5"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Описание"
                               Margin="0,0,10,5"/>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Приоритет"
                               Margin="0,0,10,5"/>

                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="Дата выполнения"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="txtTitle"
                             Grid.Row="1" Grid.Column="0"
                             Height="32"
                             Margin="0,0,10,12"/>

                    <TextBox x:Name="txtDescription"
                             Grid.Row="1" Grid.Column="1"
                             Height="32"
                             Margin="0,0,10,12"
                             VerticalContentAlignment="Center"/>

                    <ComboBox x:Name="cmbPriority"
                              Grid.Row="1" Grid.Column="2"
                              Height="32"
                              SelectedIndex="1"
                              Margin="0,0,10,12">
                        <ComboBoxItem Content="Низкий"/>
                        <ComboBoxItem Content="Средний"/>
                        <ComboBoxItem Content="Высокий"/>
                    </ComboBox>

                    <DatePicker x:Name="dpDueDate"
                                Grid.Row="1" Grid.Column="3"
                                Height="32"
                                Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Прогресс выполнения"
                               Margin="0,0,10,5"/>

                    <ComboBox x:Name="cmbProgress"
                              Grid.Row="3" Grid.Column="0"
                              Height="32"
                              SelectedIndex="0"
                              Margin="0,0,10,0">
                        <ComboBoxItem Content="0%"/>
                        <ComboBoxItem Content="25%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                    </ComboBox>
                </Grid>

                <WrapPanel Margin="0,15,0,0">
                    <Button Content="Добавить задачу"
                            Width="150"
                            Height="35"
                            Background="#493477"
                            Foreground="White"
                            Click="btnAdd_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="Сохранить изменения"
                            Width="175"
                            Height="35"
                            Click="btnEdit_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="Удалить задачу"
                            Width="150"
                            Height="35"
                            Click="btnDelete_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список задач"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#493477"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="dgTasks"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          SelectionChanged="dgTasks_SelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="35">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding Title}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Приоритет"
                                            Binding="{Binding Priority}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Срок"
                                            Binding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Прогресс"
                                            Binding="{Binding Progress, StringFormat={}{0}%}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Text="Готово к работе"
                   Foreground="#493477"
                   Margin="0,12,0,0"
                   FontSize="13"/>
    </Grid>
</Window>
