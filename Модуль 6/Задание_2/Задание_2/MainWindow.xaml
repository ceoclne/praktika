<Window x:Class="Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учёта задач"
        Height="600" Width="950"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Система учёта задач"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#51347A"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,15,0">

                <StackPanel>
                    <TextBlock Text="Информация о задаче"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Название задачи"/>
                    <TextBox x:Name="txtTitle"
                             Height="32"
                             Margin="0,5,0,12"/>

                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="txtDescription"
                             Height="75"
                             Margin="0,5,0,12"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Статус"/>
                    <ComboBox x:Name="cmbStatus"
                              Height="32"
                              Margin="0,5,0,18"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="В процессе"/>
                        <ComboBoxItem Content="Выполнена"/>
                    </ComboBox>

                    <Button Content="Добавить задачу"
                            Click="Add_Click"
                            Height="38"
                            Margin="0,0,0,8"
                            Background="#7047A3"
                            Foreground="White"/>

                    <Button Content="Обновить задачу"
                            Click="Update_Click"
                            Height="38"
                            Margin="0,0,0,8"/>

                    <Button Content="Удалить задачу"
                            Click="Delete_Click"
                            Height="38"
                            Margin="0,0,0,8"/>

                    <Button Content="Очистить поля"
                            Click="Clear_Click"
                            Height="38"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="TasksGrid"
                      Grid.Column="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="TasksGrid_SelectionChanged"
                      CanUserAddRows="False"
                      Background="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"/>
        </Grid>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="2"
                   Text="Готово к работе"
                   Foreground="#51347A"
                   Margin="0,15,0,0"
                   FontSize="14"/>
    </Grid>
</Window>