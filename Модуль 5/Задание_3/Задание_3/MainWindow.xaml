<Window x:Class="Задание_3.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="Список задач"
     Height="500" Width="500"
     MinHeight="400" MinWidth="400"
     WindowStartupLocation="CenterScreen"
     Background="#F2EDFF">

    <Border Margin="18"
        Padding="20"
        Background="White"
        CornerRadius="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Мои задачи"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#493477"
                   Margin="0,0,0,18"/>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtTask"
                     FontSize="15"
                     Padding="10"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                    Content="Добавить"
                    Click="btnAdd_Click"
                    Background="#7655C9"
                    Foreground="White"
                    Padding="12,8"
                    BorderThickness="0"
                    FontSize="14"/>
            </Grid>

            <ListBox x:Name="lstTasks"
                 Grid.Row="2"
                 FontSize="15"
                 Padding="8"
                 Background="#F7F3FF"
                 BorderBrush="#DED3F7"
                 BorderThickness="1"/>

            <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

                <Button Content="Выполнено"
                    Click="btnComplete_Click"
                    Background="#7655C9"
                    Foreground="White"
                    Padding="14,10"
                    Margin="4"
                    BorderThickness="0"
                    FontSize="14"/>

                <Button Content="Удалить"
                    Click="btnDelete_Click"
                    Background="#E3D7FA"
                    Foreground="#493477"
                    Padding="14,10"
                    Margin="4"
                    BorderThickness="0"
                    FontSize="14"/>

            </StackPanel>
        </Grid>
    </Border>

</Window>
