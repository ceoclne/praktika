<Window x:Class="Задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений"
        Height="650" Width="950"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3EEFF">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Просмотр изображений"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#493477"/>

            <TextBlock Text="Открывай изображения и изменяй масштаб"
                       FontSize="14"
                       Foreground="#81759D"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Область изображения -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DED3F7"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">

            <Grid>
                <TextBlock Text="Открой изображение, чтобы начать"
                           FontSize="16"
                           Foreground="#A69ABF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <ScrollViewer x:Name="ImageScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="White">

                    <Grid x:Name="ImageContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image x:Name="ImageViewer"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DED3F7"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14"
                Margin="0,18,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           VerticalAlignment="Center">

                    <Button Content="＋ Увеличить"
                            Click="btnZoomIn_Click"
                            Background="#7655C9"
                            Foreground="White"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="－ Уменьшить"
                            Click="btnZoomOut_Click"
                            Background="#EAE2FA"
                            Foreground="#493477"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="Сбросить"
                            Click="btnReset_Click"
                            Background="#F3EEFF"
                            Foreground="#493477"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="Открыть файл"
                            Click="btnOpen_Click"
                            Background="#493477"
                            Foreground="White"
                            Padding="16,10"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </WrapPanel>

                <TextBlock x:Name="lblZoom"
                           Grid.Column="1"
                           Text="Масштаб: 100%"
                           Foreground="#493477"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
