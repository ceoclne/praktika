using System;

class Program
{
    static void Main()
    {
        // Создаём массив из 5 названий городов
        string[] cities = { "Москва", "Витебск", "Орша", "Сочи", "Минск" };

        Console.Write("Введите название города: ");
        string city = Console.ReadLine();

        int index = -1;

        // Ищем город в массиве
        for (int i = 0; i < cities.Length; i++)
        {
            if (cities[i].Equals(city, StringComparison.OrdinalIgnoreCase))
            {
                index = i;
                break;
            }
        }

        if (index != -1)
        {
            Console.WriteLine($"Город найден. Его индекс: {index}");
        }
        else
        {
            Console.WriteLine("Такого города нет в массиве.");
        }
    }
}